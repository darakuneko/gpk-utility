{
  "license": "MIT",
  "scripts": {
    "build": "rm -rf ./dist && rm -rf ./dist-electron && npm run check && vite build && mkdir -p dist-electron && cp -r dist/* dist-electron/",
    "build:win": "del /s /q dist && del /s /q dist-electron && npm run check && vite build && xcopy dist dist-electron\\ /e /i",
    "start": "npm run build && vite build && npx electron dist-electron/index.js",
    "start:dev": "npm run build && cross-env NODE_ENV=development npx electron dist-electron/index.js",
    "start:linux": "ELECTRON_DISABLE_SANDBOX=1 npm run build && npx electron dist-electron/index.js",
    "start:linux:dev": "npm run build && ELECTRON_DISABLE_SANDBOX=1 cross-env NODE_ENV=development npx electron dist-electron/index.js",
    "type-check": "tsc --noEmit",
    "type-check:watch": "./node_modules/.bin/tsc --noEmit --watch",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "check": "npm run type-check && npm run lint",
    "check:force": "npm run type-check; npm run lint",
    "upgrade": "npx npm-check-updates -u",
    "dist:win": "npm run build:win && electron-builder -w --publish never",
    "dist:mac": "npm run build && electron-builder -m --publish never",
    "dist:linux": "npm run build && electron-builder -l --publish never"
  },
  "name": "gpk-utility",
  "version": "1.3.3",
  "description": "GPK Utility",
  "homepage": "https://github.com/darakuneko/gpk-utility",
  "author": {
    "name": "daraku-neko",
    "email": "tvkids@gmail.com"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@typescript-eslint/utils": "^8.59.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "electron": "42.0.1",
    "electron-builder": "26.8.1",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.15.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss": "^8.5.14",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "main": "./dist-electron/index.js",
  "dependencies": {
    "@electron/notarize": "^3.1.1",
    "@paymoapp/active-window": "^2.1.4",
    "@types/react-color": "^3.0.13",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "node-fetch": "^3.3.2",
    "node-hid": "^3.3.0",
    "react": "19.2.6",
    "react-color": "^2.19.3",
    "react-dom": "19.2.6"
  },
  "build": {
    "productName": "GPK Utility",
    "appId": "app.darakuneko.gpk_utility",
    "afterSign": "./dist-electron/notarize.cjs",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "darakuneko",
      "repo": "gpk-utility"
    },
    "files": [
      "dist-electron/**/*",
      "icons/*",
      "package.json",
      "src/i18n/locales/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/256x256.ico"
    },
    "mac": {
      "icon": "icons/512x512.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "category": "public.app-category.productivity",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icons"
    }
  }
}
